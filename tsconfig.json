{
  "compilerOptions": {
    "target": "ESNext",
    "jsx": "preserve",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.vue",
    "scripts/**/*.ts",
    "vite.config.ts",
    "vite.embed.config.ts",
    "vitest.config.ts",
    "uno.config.ts",
    "eslint.config.js"
  ]
}
